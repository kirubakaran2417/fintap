# Copy values into your shell or a local env file. Do not commit secrets.

# ONDC pre-prod / mock (https://resources.ondc.org/tech-resources)
ONDC_ENABLED=true
ONDC_SUBSCRIBER_ID=fintap.local
ONDC_UNIQUE_KEY_ID=ukid-1
ONDC_SUBSCRIBER_URL=https://your-public-host/protocol/v1
ONDC_SIGNING_PRIVATE_KEY=
ONDC_SIGNING_PUBLIC_KEY=
ONDC_ENCRYPTION_PRIVATE_KEY=
ONDC_REGISTRY_URL=https://preprod.registry.ondc.org
ONDC_GATEWAY_URL=https://preprod.gateway.ondc.org
ONDC_MOCK_BPP_URL=https://mock.ondc.org/api/b2b/bpp
ONDC_DOMAIN=ONDC:RET10
ONDC_CITY=std:080
ONDC_BPP_ID=
ONDC_BPP_URI=https://your-public-host/protocol/v1

# Mastercard Payment Gateway Services sandbox (test-gateway.mastercard.com)
MC_GATEWAY_ENABLED=true
MC_GATEWAY_URL=https://test-gateway.mastercard.com
MC_MERCHANT_ID=
MC_API_PASSWORD=
MC_API_VERSION=100

# Razorpay test (preferred live card rail when MPGS keys are not available)
RAZORPAY_ENABLED=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Mastercard Developers portal OAuth1 (sandbox.api.mastercard.com + .p12)
MC_DEV_ENABLED=false
MC_DEV_BASE_URL=https://sandbox.api.mastercard.com
MC_CONSUMER_KEY=
MC_KEYSTORE_PATH=
MC_KEYSTORE_PASSWORD=
MC_KEY_ALIAS=
